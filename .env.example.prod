# Production contract. Supply values through the approved secret/config store.
NODE_ENV=production
PORT=3000
MONGO_URI=replace-with-production-database-uri
REDIS_URL=replace-with-production-redis-uri
FINANCIAL_DATABASE_URL=replace-with-production-postgresql-uri
FINANCIAL_WORKERS_ENABLED=false
RATE_LIMIT_STORE=redis

JWT_SECRET=replace-with-random-secret-at-least-32-characters
JWT_EXPIRY=15m
JWT_ISSUER=replace-with-production-issuer
JWT_AUDIENCE=replace-with-production-audience
REFRESH_TOKEN_SECRET=replace-with-distinct-random-secret-at-least-32-characters
REFRESH_TOKEN_EXPIRY=7d
PASSWORD_RESET_SECRET=replace-with-distinct-random-secret-at-least-32-characters
PASSWORD_RESET_EXPIRY=15m
CSRF_SECRET=replace-with-distinct-random-secret-at-least-32-characters

COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=replace-with-cookie-domain-if-required
TRUST_PROXY=replace-with-explicit-trusted-proxy-setting
CORS_ORIGIN=https://replace-with-approved-frontend-origin.example.invalid
FRONTEND_URL=https://replace-with-approved-frontend-origin.example.invalid
BACKEND_URL=https://replace-with-approved-backend-origin.example.invalid

AUTH_EMAIL_BYPASS=false
KYC_BYPASS=false
KYC_PROVIDER=didit
KYC_PROVIDER_MODE=live
DIDIT_SANDBOX=false
DIDIT_API_KEY=replace-with-live-api-key
DIDIT_CLIENT_ID=replace-with-live-client-id
DIDIT_WORKFLOW_ID=replace-with-live-workflow-id
DIDIT_WEBHOOK_SECRET=replace-with-random-webhook-secret

SIWE_DOMAIN=replace-with-approved-frontend-host
SIWE_URI=https://replace-with-approved-frontend-origin.example.invalid
SIWE_CHAIN_IDS=replace-with-approved-chain-ids

SENDGRID_API_KEY=replace-with-email-provider-key
EMAIL_FROM=replace-with-verified-sender@example.invalid
GOOGLE_CLIENT_ID=replace-with-google-client-id
APPLE_CLIENT_ID=replace-with-apple-client-id

BLOCKCHAIN_FEATURES_ENABLED=false
PLATFORM_SIGNER_PROVIDER=disabled
INVESTMENTS_TEST_MODE=false
ROI_REQUIRE_ONCHAIN_PROVISIONING=true
ROI_DISABLE_NFT_MINTING=true

FLUTTERWAVE_PUBLIC_KEY=replace-with-provider-public-key
FLUTTERWAVE_SECRET_KEY=replace-with-provider-secret-key
FLUTTERWAVE_ENCRYPTION_KEY=replace-with-provider-encryption-key
FLUTTERWAVE_WEBHOOK_SECRET=replace-with-provider-webhook-secret
DPO_COMPANY_TOKEN=replace-with-provider-company-token
DPO_API_URL=replace-with-provider-api-url
DPO_PAYMENT_URL=replace-with-provider-payment-url
DPO_FEE_RATE_BPS=replace-with-approved-provider-fee-bps
DPO_FEE_VAT_RATE_BPS=replace-with-approved-provider-fee-vat-bps
KEIBO_INBOUND_FEE_RATE_BPS=replace-with-approved-inbound-platform-fee-bps
