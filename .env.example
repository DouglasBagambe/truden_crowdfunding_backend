# Development only. Copy locally and replace every placeholder you use.
NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/keibo_development
REDIS_URL=redis://127.0.0.1:6379
FINANCIAL_DATABASE_URL=postgresql://keibo:keibo@127.0.0.1:5432/keibo_financial
FINANCIAL_WORKERS_ENABLED=false
RATE_LIMIT_STORE=memory

JWT_SECRET=replace-with-development-jwt-secret
JWT_EXPIRY=15m
JWT_ISSUER=keibo-development
JWT_AUDIENCE=keibo-development-web
REFRESH_TOKEN_SECRET=replace-with-development-refresh-secret
REFRESH_TOKEN_EXPIRY=7d
PASSWORD_RESET_SECRET=replace-with-development-reset-secret
PASSWORD_RESET_EXPIRY=15m
CSRF_SECRET=replace-with-development-csrf-secret

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
TRUST_PROXY=loopback
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000

AUTH_EMAIL_BYPASS=false
KYC_BYPASS=false
KYC_PROVIDER=didit
KYC_PROVIDER_MODE=sandbox
DIDIT_API_KEY=replace-with-sandbox-api-key
DIDIT_CLIENT_ID=replace-with-sandbox-client-id
DIDIT_WORKFLOW_ID=replace-with-sandbox-workflow-id
DIDIT_WEBHOOK_SECRET=replace-with-sandbox-webhook-secret

SIWE_DOMAIN=localhost:3000
SIWE_URI=http://localhost:3000
SIWE_CHAIN_IDS=84532

SENDGRID_API_KEY=replace-with-email-provider-key
EMAIL_FROM=replace-with-verified-sender@example.invalid
GOOGLE_CLIENT_ID=replace-with-google-client-id
APPLE_CLIENT_ID=replace-with-apple-client-id

BLOCKCHAIN_FEATURES_ENABLED=false
PLATFORM_SIGNER_PROVIDER=disabled
RPC_URL=
CHAIN_ID=
CHAIN_NAME=
ESCROW_CONTRACT_ADDRESS=
NFT_CONTRACT_ADDRESS=
VOTING_CONTRACT_ADDRESS=
DEALROOM_CONTRACT_ADDRESS=
TREASURY_CONTRACT_ADDRESS=

FLUTTERWAVE_PUBLIC_KEY=replace-with-provider-public-key
FLUTTERWAVE_SECRET_KEY=replace-with-provider-secret-key
FLUTTERWAVE_ENCRYPTION_KEY=replace-with-provider-encryption-key
FLUTTERWAVE_WEBHOOK_SECRET=replace-with-provider-webhook-secret
DPO_COMPANY_TOKEN=replace-with-provider-company-token
DPO_API_URL=replace-with-provider-api-url
DPO_PAYMENT_URL=replace-with-provider-payment-url
DPO_FEE_RATE_BPS=250
DPO_FEE_VAT_RATE_BPS=1800
KEIBO_INBOUND_FEE_RATE_BPS=0

INVESTMENTS_TEST_MODE=false
ROI_REQUIRE_ONCHAIN_PROVISIONING=true
ROI_DISABLE_NFT_MINTING=true
